{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-mailguard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [],
  // Preserve dashboard Variables & Secrets not listed under vars (needed for
  // Workers Builds / Git deploys so personal FORWARD_TO / LLM_* stay intact).
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // LLM_API_KEY is a secret — set in the dashboard or `wrangler secret put`.
  // FORWARD_TO, LLM_MODEL, and LLM_BASE_URL are managed in the dashboard for
  // production so Git-triggered deploys do not overwrite them.
  "vars": {
    "ALLOW_LIST": "",
    "BLOCK_LIST": "",
    "SPAM_THRESHOLD": "5.0",
    "LLM_PROVIDER": "openai_chat"
  }
}
