{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-mailguard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [],
  // LLM_API_KEY is a secret — use `wrangler secret put LLM_API_KEY` or `.dev.vars` locally.
  "vars": {
    // Must be a verified Email Routing destination address.
    "FORWARD_TO": "you@example.com",
    "ALLOW_LIST": "",
    "BLOCK_LIST": "",
    "SPAM_THRESHOLD": "5.0",
    "LLM_PROVIDER": "openai_chat",
    "LLM_MODEL": "gpt-4.1-mini",
    "LLM_BASE_URL": ""
  }
}
